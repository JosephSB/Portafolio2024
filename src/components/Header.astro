---
const currentPath = Astro.url.pathname;
const isActive = (base: string) => currentPath === base || currentPath.startsWith(base + "/");
---

<header class="container-header">
  <div class="header">
    <a href="/"><p class="title">JosephSB</p></a>
    <ul class="menu">
      <li class="menu-link"><a class={isActive("/products") ? "active" : ""} href="/products">Productos</a></li>
      <li class="menu-link"><a class={isActive("/blog") ? "active" : ""} href="/blog">Blog</a></li>
      <li class="menu-link"><a class={isActive("/projects") ? "active" : ""} href="/projects">Proyectos</a></li>
      <li class="menu-link d-none" id="btn-dark">
        <i class="fa-solid fa-moon"></i>
      </li>
      <li class="menu-link d-none" id="btn-light">
        <i class="fa-solid fa-sun"></i>
      </li>
    </ul>
  </div>
</header>

<script>
  const btnLight = document.getElementById("btn-light");
  const btnDark = document.getElementById("btn-dark");

  const currentTheme = localStorage.getItem("theme");

  if (currentTheme) {
    document.documentElement.setAttribute("data-theme", currentTheme);
    if (currentTheme === "light") btnDark?.classList.remove("d-none")
    else  btnLight?.classList.remove("d-none")
  }

  function switchTheme() {
    const currentTheme = localStorage.getItem("theme");
    if (currentTheme === "light") {
      document.documentElement.setAttribute("data-theme", "dark");
      localStorage.setItem("theme", "dark");
      btnLight?.classList.remove("d-none")
      btnDark?.classList.add("d-none")
    } else {
      document.documentElement.setAttribute("data-theme", "light");
      localStorage.setItem("theme", "light");
      btnLight?.classList.add("d-none")
      btnDark?.classList.remove("d-none")
    }
  }

  btnDark?.addEventListener("click", switchTheme, false);
  btnLight?.addEventListener("click", switchTheme, false);
</script>

<style>
  .container-header {
    width: 100%;
    height: var(--size-header);
    position: fixed;
    top: 0;
    left: 0;
    z-index: 5;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    background-color: var(--bd-color-transparent);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .header {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .title {
    margin: 0;
    font-family: var(--secondary-font);
    color: var(--text-color);
    font-size: 1.2rem;
  }
  .menu {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }
  .menu-link {
    text-decoration: none;
  }
  .menu-link a {
    cursor: pointer;
    color: var(--text-color);
    font-size: 14px;
    transition: color 0.2s ease;
  }
  .menu-link a:hover,
  .menu-link a.active {
    color: var(--primary-color);
  }
  .menu-link i {
    cursor: pointer;
    color: var(--text-color);
  }
  .d-none {
    display: none;
  }
  @media screen and (max-width: 600px) {
    .menu { gap: 0.85rem; }
    .menu-link a { font-size: 12px; }
    .title { font-size: 1rem; }
  }
</style>
