---
import GameOfLife from "./GameOfLife.astro";
---

<div class="page-top-strip">
  <GameOfLife
    cell={16}
    rate={12}
    density={0.15}
    trail={0.15}
    opacity={0.55}
    interactive={false}
  />
</div>

<style>
  .page-top-strip {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-top: calc(-1 * (var(--size-header) + 10px) - 1rem);
    margin-bottom: 1.5rem;
    height: 120px;
    overflow: hidden;
    background-color: var(--bd-color);
    padding-top: calc(var(--size-header) + 10px);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 70%, transparent 100%);
            mask-image: linear-gradient(to bottom, #000 0%, #000 70%, transparent 100%);
  }
  @media screen and (max-width: 600px) {
    .page-top-strip { height: 100px; }
  }
</style>
