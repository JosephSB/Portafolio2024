---
interface Props {
    class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class={`blackhole ${className}`}>
    <canvas class="blackhole-canvas"></canvas>
</div>

<script>
    function initBlackHole(canvas: HTMLCanvasElement) {
        if (canvas.dataset.bhInit === '1') return;
        canvas.dataset.bhInit = '1';

        const gl = canvas.getContext('webgl', { antialias: false, premultipliedAlpha: false });
        if (!gl) return;

        const dpr = Math.min(window.devicePixelRatio || 1, 2);

        function resize() {
            const parent = canvas.parentElement!;
            const w = parent.clientWidth;
            const h = parent.clientHeight;
            if (w === 0 || h === 0) return;
            canvas.width = Math.floor(w * dpr);
            canvas.height = Math.floor(h * dpr);
            canvas.style.width = w + 'px';
            canvas.style.height = h + 'px';
            gl!.viewport(0, 0, canvas.width, canvas.height);
        }

        const vertSrc = `
attribute vec2 position;
void main() { gl_Position = vec4(position, 0.0, 1.0); }`;

        const fragSrc = `
precision highp float;
uniform float u_time;
uniform vec2 u_resolution;

float hash(vec2 p) { return fract(sin(dot(p, vec2(41.3, 289.1))) * 45758.5453); }
float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
}
float fbm(vec2 p) {
    float v = 0.0; float a = 0.5;
    for (int i = 0; i < 5; i++) { v += a * noise(p); p *= 2.05; a *= 0.5; }
    return v;
}
float stars(vec2 p, float sh) {
    float n = hash(floor(p * 240.0));
    return smoothstep(0.995, 1.0, n) * sh;
}

void main() {
    vec2 uv = gl_FragCoord.xy / u_resolution.xy;

    // aspect corrected coord; hole center just below bottom edge
    float ar = u_resolution.x / u_resolution.y;
    vec2 p = uv;
    p.x = (p.x - 0.5) * ar;
    p.y = p.y - (-0.02);

    float r = length(p);
    vec2 dir = r > 0.0001 ? p / r : vec2(0.0);

    // event horizon radius
    float holeR = 0.30;

    // glass-like lensing — refract a subtle background pattern
    float pull = holeR / max(r, 0.001);
    float bend = pull * pull * 0.55;

    // ripple ring around the hole for that glass wobble
    float ripple = sin((r - holeR) * 40.0 - u_time * 1.6) * smoothstep(holeR * 3.0, holeR, r) * 0.015;
    vec2 lensedUV = uv - dir * (bend * 0.10 + ripple);

    // chromatic aberration on the refraction (glass split)
    float chroma = smoothstep(holeR * 3.5, holeR * 1.05, r) * 0.006;
    vec2 uvR = lensedUV + dir * chroma;
    vec2 uvB = lensedUV - dir * chroma;

    // faint moving field to refract (very subtle, mostly to give the lens something to bend)
    float fR = fbm(uvR * 3.2 + vec2(0.0, -u_time * 0.05));
    float fG = fbm(lensedUV * 3.2 + vec2(0.0, -u_time * 0.05));
    float fB = fbm(uvB * 3.2 + vec2(0.0, -u_time * 0.05));
    vec3 refr = vec3(fR, fG, fB);

    // base background matches the site
    vec3 bg = vec3(0.125, 0.125, 0.137);

    // subtle palette — cool near-white with the barest hint of green
    vec3 rim   = vec3(0.90, 0.94, 0.92);
    vec3 tint  = vec3(0.55, 0.72, 0.65);

    // photon ring (thin bright rim)
    float ring = smoothstep(0.004, 0.0, abs(r - holeR * 1.015));

    // outer soft glow — dim, blends into bg
    float glow = smoothstep(holeR * 2.6, holeR * 1.0, r) * 0.18;

    // compose: start from bg + subtle refraction wash
    vec3 color = bg;
    color = mix(color, mix(bg, tint, 0.35), (refr.g - 0.5) * smoothstep(holeR * 3.2, holeR * 1.05, r) * 0.35);
    // let the chromatic split show near the rim
    color.r += (refr.r - refr.g) * smoothstep(holeR * 2.2, holeR * 1.05, r) * 0.35;
    color.b += (refr.b - refr.g) * smoothstep(holeR * 2.2, holeR * 1.05, r) * 0.35;

    color += rim * ring * 0.9;
    color += tint * glow;

    // event horizon — hard black
    float hole = smoothstep(holeR + 0.003, holeR - 0.003, r);
    color = mix(color, vec3(0.0), hole);

    // fine grain
    float g = (hash(gl_FragCoord.xy + fract(u_time)) - 0.5) * 0.04;
    color += g;

    gl_FragColor = vec4(color, 1.0);
}`;

        function compile(type: number, src: string) {
            const s = gl!.createShader(type)!;
            gl!.shaderSource(s, src);
            gl!.compileShader(s);
            return s;
        }

        const prog = gl.createProgram()!;
        gl.attachShader(prog, compile(gl.VERTEX_SHADER, vertSrc));
        gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, fragSrc));
        gl.linkProgram(prog);
        gl.useProgram(prog);

        const buf = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 1,-1, -1,1, 1,1]), gl.STATIC_DRAW);
        const posLoc = gl.getAttribLocation(prog, 'position');
        gl.enableVertexAttribArray(posLoc);
        gl.vertexAttribPointer(posLoc, 2, gl.FLOAT, false, 0, 0);

        const timeLoc = gl.getUniformLocation(prog, 'u_time');
        const resLoc = gl.getUniformLocation(prog, 'u_resolution');

        resize();
        window.addEventListener('resize', resize);

        let running = true;
        const io = new IntersectionObserver((entries) => {
            for (const e of entries) running = e.isIntersecting;
        });
        io.observe(canvas);

        function render(t: number) {
            if (running) {
                gl!.uniform1f(timeLoc, t * 0.001);
                gl!.uniform2f(resLoc, canvas.width, canvas.height);
                gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);
            }
            requestAnimationFrame(render);
        }
        requestAnimationFrame(render);
    }

    function initAll() {
        document.querySelectorAll<HTMLCanvasElement>('.blackhole-canvas').forEach(initBlackHole);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll);
    } else {
        initAll();
    }
</script>

<style>
    .blackhole {
        position: relative;
        width: 100vw;
        margin-left: calc(0px);
        left: 0;
        height: 180px;
        margin-top: -90px; /* overlap the footer so it looks pulled in */
        overflow: hidden;
        background-color: transparent;
        pointer-events: none;
        -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 45%, black 100%);
                mask-image: linear-gradient(to bottom, transparent 0%, black 45%, black 100%);
    }
    .blackhole-canvas {
        display: block;
        width: 100%;
        height: 100%;
    }
    @media screen and (max-width: 600px) {
        .blackhole { height: 140px; margin-top: -70px; }
    }
</style>
