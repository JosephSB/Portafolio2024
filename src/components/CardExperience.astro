---
interface Props {
  date: string;
  title: string;
  company?: string;
  body: string;
  skills: string[];
}

const { date, skills, title, company, body } = Astro.props;
---

<div class="card-exp">
  <p class="titleDate">{date}</p>
  <div>
    <p class="title">{title}</p>
    {company && <p class="company">{company}</p>}
    <p>{body}</p>
    <ul class="list-skills">
      {skills.map((item) => <li class="item-skill">{item}</li>)}
    </ul>
  </div>
</div>

<style>
  .card-exp {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 2.5fr;
    color: var(--text-color-2);
  }
  .title {
    color: var(--text-color);
    font-weight: bold;
    margin: 0 0 4px;
  }
  .company {
    color: var(--primary-color);
    font-size: 0.85rem;
    margin: 0 0 12px;
    font-weight: 500;
  }
  .list-skills {
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .item-skill {
    background-color: var(--bd-color-2);
    font-size: 0.7rem;
    color: var(--text-color);
    width: auto;
    padding: 0.5rem;
    border-radius: 10px;
  }
  @media screen and (max-width: 600px) {
    .card-exp {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .titleDate {
      margin-bottom: 0;
      margin-top: 2rem;
    }
  }
</style>
