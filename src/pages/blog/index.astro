---
import HtmlGeneralLayout from "../../layouts/HtmlGeneralLayout.astro";
import DataBlog from "../../data/blog.json";
import { STORGE_BLOBS } from "../../config";
import Breadcrumb from "../../components/Breadcrumb.astro";

const posts = [...DataBlog].sort((a, b) => b.date.localeCompare(a.date));
---

<HtmlGeneralLayout
  description="Blog de Joseph Silva Bendezu sobre ingeniería de software, IA aplicada, arquitectura backend y liderazgo técnico."
  title="Blog | Joseph Silva Bendezu - Software Engineer, AI Engineer"
>
  <div class="blog-page">
    <Breadcrumb items={[{ label: "JosephSB", href: "/" }, { label: "Blog" }]} />
    <h1 class="page-title">Blog</h1>
    <p class="page-lede">
      Notas sobre construcción de producto con IA, arquitectura backend y
      liderazgo técnico.
    </p>
    <div class="post-list">
      {
        posts.map((p) => (
          <a class="post-item" href={`/blog/${p.id}`}>
            <img class="post-cover" src={`${STORGE_BLOBS}${p.cover}`} alt={p.title} loading="lazy" />
            <div class="post-body">
              <p class="post-date">
                {new Date(p.date).toLocaleDateString("es-PE", { year: "numeric", month: "long", day: "numeric" })}
              </p>
              <h2 class="post-title">{p.title}</h2>
              <p class="post-excerpt">{p.excerpt}</p>
              <ul class="post-tags">
                {p.tags.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</HtmlGeneralLayout>

<style>
  .blog-page { width: 100%; }
  .detail-nav {
    width: 100%;
    padding: 0;
    margin: 1rem 0;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-color);
  }
  .detail-nav-highlight {
    color: var(--primary-color);
    font-family: var(--secondary-font);
  }
  .page-title {
    font-family: var(--secondary-font);
    color: var(--text-color);
    margin: 1rem 0 0.5rem;
    font-size: 1.5rem;
  }
  .page-lede { color: var(--text-color-2); margin: 0 0 2rem; }
  .post-list { display: flex; flex-direction: column; gap: 1.5rem; }
  .post-item {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1.5rem;
    padding: 1rem;
    border-radius: 12px;
    background-color: rgba(22, 22, 26, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .post-item:hover {
    border-color: var(--primary-color);
    transform: translateY(-2px);
  }
  .post-cover {
    width: 100%;
    height: 100%;
    max-height: 160px;
    object-fit: cover;
    border-radius: 8px;
  }
  .post-body { display: flex; flex-direction: column; gap: 0.5rem; }
  .post-date {
    color: var(--text-color-2);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }
  .post-title {
    color: var(--text-color);
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.3;
  }
  .post-excerpt { color: var(--text-color-2); margin: 0; font-size: 14px; line-height: 1.5; }
  .post-tags {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .post-tags li {
    padding: 0.3rem 0.7rem;
    background-color: var(--bd-color-2);
    border-radius: 999px;
    color: var(--text-color);
    font-size: 11px;
  }
  @media screen and (max-width: 700px) {
    .post-item { grid-template-columns: 1fr; }
    .post-cover { max-height: 200px; }
  }
</style>
