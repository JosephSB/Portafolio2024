---
import HtmlGeneralLayout from "../../layouts/HtmlGeneralLayout.astro";
import DataProjects from "../../data/projects.json";
import CardListItem from "../../components/CardListItem.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PageTopStrip from "../../components/PageTopStrip.astro";
---

<HtmlGeneralLayout
  description="Proyectos de desarrollo web en JavaScript, ReactJS, NextJS, NodeJS de Joseph Silva Bendezu."
  title="Proyectos | Joseph Silva Bendezu - Software Engineer, FullStack Developer"
>
  <div class="projects-page">
    <PageTopStrip />
    <Breadcrumb items={[{ label: "JosephSB", href: "/" }, { label: "Proyectos" }]} />
    <header class="page-header">
      <h1 class="page-title">Proyectos</h1>
      <p class="page-lede">
        Colección de proyectos personales y experimentos técnicos que he
        construido a lo largo de mi carrera para explorar tecnologías y afinar
        el oficio.
      </p>
    </header>

    <div class="items-grid">
      {
        DataProjects.map((item) => (
          <CardListItem
            href={`/projects/${item.id}`}
            image={item.portadas[0]}
            title={item.name}
            description={item.description}
            tags={item.tags}
            technologies={item.technologies}
            meta={item.isTop ? "Destacado" : undefined}
          />
        ))
      }
    </div>
  </div>
</HtmlGeneralLayout>

<style>
  .projects-page { width: 100%; padding-bottom: 3rem; }
  .page-header {
    margin: 1.5rem 0 2.5rem;
    max-width: 720px;
  }
  .page-title {
    font-family: var(--secondary-font);
    color: var(--text-color);
    margin: 0 0 0.75rem;
    font-size: 1.6rem;
    line-height: 1.25;
  }
  .page-lede {
    color: var(--text-color-2);
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
  }
  .items-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
</style>
