---
import CardExperience from "../components/CardExperience.astro";
import Layout from "../layouts/HtmlGeneralLayout.astro";
import DataExperiences from "../data/experiences.json";
import DataProjects from "../data/projects.json";
import DataSideProjects from "../data/sideprojects.json";
import DataSkills from "../data/skills.json";
import CardProject from "../components/CardProject.astro";
import CardSideProject from "../components/CardSideProject.astro";
import { Icon } from "astro-icon/components";
import GameOfLife from "../components/GameOfLife.astro";
import Carousel from "../components/Carousel.astro";
import "../styles/GridGallery.css";
import { STORGE_BLOBS } from "../config";

---

<Layout
  description="Soy Joseph Nahun Silva Bendezu, con más de 6 años de experiencia diseñando y desarrollando aplicaciones web, agentes AI, arquitecturas y plataformas SaaS."
  title="Joseph Nahun Silva Bendezu - Software Engineer, AI Engineer, FullStack Developer"
>
  <div class="home-banner">
    <GameOfLife cell={12} rate={20} density={0.06} trail={0.08} opacity={0.35} interactive={false} />
    <div class="banner-inner">
      <div class="banner-content">
        <h1 class="banner-title">&gt;&lowbar; Joseph Nahun Silva Bendezu</h1>
        <p class="banner-subtitle">Software Engineer | AI Engineer | FullStack Developer</p>
        <div class="banner-links">
          <a
            class="banner-link"
            href={`${STORGE_BLOBS}cv-joseph-silva.pdf`}
            target="_blank"
            rel="noopener"
            aria-label="Curriculum"
            title="Curriculum"
          >
            <Icon name="mdi:file-document-outline" />
          </a>
          <a
            class="banner-link"
            href="https://github.com/JosephSB"
            target="_blank"
            rel="noopener"
            aria-label="GitHub"
          >
            <Icon name="simple-icons:github" />
          </a>
          <a
            class="banner-link"
            href="https://www.linkedin.com/in/joseph-silva-bendezu/"
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn"
          >
            <Icon name="simple-icons:linkedin" />
          </a>
          <a
            class="banner-link"
            href="https://www.tiktok.com/@_josephsb"
            target="_blank"
            rel="noopener"
            aria-label="TikTok"
          >
            <Icon name="simple-icons:tiktok" />
          </a>
        </div>
      </div>
      <div class="banner-img-wrapper">
        <img
          class="banner-img"
          src="/images/FotoJoseph.webp"
          alt="Joseph Nahun Silva Bendezu"
        />
      </div>
    </div>
  </div>
  <div class="home-with-sides">
    <div class="side-gol side-gol-left">
      <GameOfLife cell={10} rate={12} trail={0.6} opacity={0.4} cursorOnly lifetime={30} />
    </div>
    <div class="side-gol side-gol-right">
      <GameOfLife cell={10} rate={12} trail={0.6} opacity={0.4} cursorOnly lifetime={30} />
    </div>
  <div class="home-about">
    <p class="home-subtitle">Sobre Mi</p>
    <p class="about-text">
      Soy Joseph Nahun Silva Bendezu, Ingeniero de Software Senior radicado en
      Lima, Perú, con más de 6 años de experiencia diseñando y desarrollando
      aplicaciones web, agentes AI, arquitecturas y plataformas SaaS.
      <br /><br />
      Me especializo en Inteligencia Artificial aplicada a producto: agentes
      inteligentes, búsqueda vectorial, prompt engineering, integraciones con
      OpenAI y Gemini Enterprise Platform, y automatización de procesos con
      n8n.
      <br /><br />
      Domino un stack Fullstack moderno: TypeScript, NestJS, NodeJS, ReactJS,
      Angular, NextJS, GraphQL, PostgreSQL, MongoDB, Docker, Google Cloud y
      AWS, además de metodologías ágiles (SCRUM), testing (Vitest, Jest) y
      prácticas DevOps.
      <br /><br />
      A lo largo de mi carrera he liderado equipos de más de 6 personas,
      gestionando la planificación técnica, la calidad del código y la entrega
      continua. Me caracterizan el liderazgo, la resiliencia y la capacidad de
      sostener el ritmo de proyectos complejos hasta llevarlos a producción.
      <br /><br />
      Adicionalmente soy fundador de CVMATCHER, una plataforma de
      empleabilidad impulsada por IA donde aplico y valido muchas de estas
      prácticas.
    </p>
  </div>
    <div class="home-exp">
    <div class="section-heading">
      <p class="home-subtitle">Productos Digitales</p>
      <a class="section-link" href="/products">Ver todos&nbsp;<i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <Carousel duration={45}>
      {
        DataSideProjects.map((item) => (
          <div class="carousel-card sideproject-card">
            <CardSideProject
              id={item.id}
              title={item.name}
              skills={item.technologies.map((x) => x.name)}
              image={item.portadas[0]}
              Repositorio={item.Repositorio}
              demo={item.Demo}
              alwaysOverlay
            />
          </div>
        ))
      }
    </Carousel>
  </div>
  <div class="home-exp">
    <p class="home-subtitle">Experiencia</p>
    {DataExperiences.map((item) => <CardExperience {...item} />)}
  </div>
  <div class="home-projects">
    <div class="section-heading">
      <p class="home-subtitle">Proyectos</p>
      <a class="section-link" href="/projects">Ver todos&nbsp;<i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <Carousel duration={55}>
      {
        DataProjects.map((item) => (
          <div class="carousel-card project-card">
            <CardProject
              id={`/projects/${item.id}`}
              href={`/projects/${item.id}`}
              title={item.name}
              skills={item.technologies.map((x) => x.name)}
              image={item.portadas[0]}
              alwaysOverlay
            />
          </div>
        ))
      }
    </Carousel>
  </div>
  <div class="home-skills">
    <p class="home-subtitle">Tecnologias</p>
    <div class="container-skills">
      {
        DataSkills.map((item) => (
          <div class="skill-item">
            <p>{item.name}</p>
            <ul>
              {item.skills.map((x) => (
                <li>
                  <Icon class="skill-icon" name={x.icon} />
                  {x.name}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
  <div class="home-contact">
    <p class="home-subtitle">Contactame</p>
    <div class="container-contact">
      <div class="item-contact">
        <p class="contact-subtitle">Telefono</p>
        <p class="contact-title">
          <a href="tel:+51963032870"
            >+51 963 032 870&nbsp;<i
              class="fa-solid fa-arrow-up-right-from-square"></i></a
          >
        </p>
      </div>
      <div class="item-contact">
        <p class="contact-subtitle">Email</p>
        <p class="contact-title">
          <a href="mailto:josephsb353@correo.com"
            >josephsb353@gmail.com&nbsp;<i
              class="fa-solid fa-arrow-up-right-from-square"></i></a
          >
        </p>
      </div>
      <div class="item-contact">
        <p class="contact-subtitle">Resume</p>
        <p class="contact-title">
          <a href={`${STORGE_BLOBS}cv-joseph-silva.pdf`} target="_blank"
            >Ver Resume&nbsp;<i class="fa-solid fa-arrow-up-right-from-square"
            ></i></a
          >
        </p>
      </div>
    </div>
  </div>
  </div>
</Layout>

<style>
  .home-banner {
    position: relative;
    /* Break out of the .app container to span full viewport width */
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    /* Pull up under the fixed header so the aurora sits behind it */
    margin-top: calc(-1 * (var(--size-header) + 10px) - 1rem);
    margin-bottom: 3rem;
    min-height: 100vh;
    padding: calc(var(--size-header) + 40px) 1rem 3rem;
    overflow: hidden;
    background-color: var(--bd-color);
    isolation: isolate;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .banner-inner {
    width: 100%;
    max-width: var(--max-width);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    position: relative;
    z-index: 2;
    padding: 1.25rem 1.5rem;
    border-radius: 16px;
    background-color: rgba(8, 8, 10, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .banner-content {
    flex: 1 1 auto;
    min-width: 0;
  }
  .banner-title {
    margin: 5px 0;
    line-height: 1.15;
    font-family: var(--secondary-font);
    color: var(--primary-color);
  }
  .banner-subtitle {
    margin: 5px 0;
    color: var(--text-color);
  }
  .banner-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }
  .banner-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 40px;
    width: 40px;
    padding: 0;
    border-radius: 999px;
    color: var(--text-color);
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(6px);
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
    font-size: 16px;
  }
  .banner-link:hover {
    color: var(--primary-color);
    border-color: var(--primary-color);
    transform: translateY(-2px);
  }
  .banner-img-wrapper {
    flex-shrink: 0;
    width: 260px;
    height: 260px;
    overflow: hidden;
    border-radius: 63% 37% 54% 46% / 55% 48% 52% 45%;
    animation: blob-morph 14s ease-in-out infinite alternate;
  }
  .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background-color: var(--bd-color);
  }
  @keyframes blob-morph {
    0%   { border-radius: 63% 37% 54% 46% / 55% 48% 52% 45%; }
    50%  { border-radius: 48% 52% 41% 59% / 62% 44% 56% 38%; }
    100% { border-radius: 58% 42% 60% 40% / 45% 55% 45% 55%; }
  }
  .home-about,
  .home-exp,
  .home-projects,
  .home-skills {
    width: 100%;
    margin-bottom: 2rem;
  }
  .home-with-sides {
    position: relative;
  }
  .side-gol {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 70px;
    z-index: 0;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 8%, #000 92%, transparent 100%);
            mask-image: linear-gradient(to bottom, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }
  .side-gol-left {
    left: calc(50% - 50vw + 12px);
  }
  .side-gol-right {
    right: calc(50% - 50vw + 12px);
  }
  @media screen and (max-width: 900px) {
    .side-gol { display: none; }
  }
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .section-link {
    color: var(--text-color-2);
    font-size: 13px;
    transition: color 0.2s ease;
  }
  .section-link:hover { color: var(--primary-color); }
  .carousel-card {
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
  }
  .sideproject-card { width: 340px; height: 220px; }
  .project-card { width: 240px; height: 200px; }
  @media screen and (max-width: 600px) {
    .sideproject-card { width: 280px; height: 200px; }
    .project-card { width: 200px; height: 180px; }
  }
  .home-subtitle {
    margin: 5px 0;
    font-family: var(--secondary-font);
    color: var(--text-color);
  }
  .home-project-link {
    width: 100%;
    text-align: center;
  }
  .home-project-link a {
    color: var(--text-color-2);
  }
  .home-project-link a:hover {
    color: var(--text-color);
  }
  .about-text {
    color: var(--text-color-2);
  }
  .container-skills {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .skill-item {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 1rem;
    color: var(--text-color);
  }
  .skill-item p {
    color: var(--text-color-2);
  }
  .skill-item ul {
    padding: 0;
    width: 100%;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .skill-item li {
    height: max-content;
    font-size: 10px;
    background-color: var(--bd-color-2);
    padding: 0.5rem 1rem;
    border-radius: 10px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .skill-icon {
    width: 18px;
    height: 18px;
    color: var(--text-color);
  }
  .container-contact {
    width: 100%;
    color: var(--text-color);
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .item-contact {
    display: grid;
    grid-template-columns: 100px 1fr;
    align-items: center;
    justify-content: center;
  }
  .contact-subtitle {
    color: var(--text-color-2);
  }
  .item-contact a {
    color: var(--text-color);
  }
  .item-contact i {
    font-size: xx-small;
  }
  .contact-title {
    cursor: pointer;
    font-size: 14px;
  }

  /*---------RESPONSIVE---------*/
  @media screen and (max-width: 600px) {
    .home-sideprojects-content{
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 1fr;
    }
    .home-banner {
      min-height: auto;
      padding: calc(var(--size-header) + 30px) 1.5rem 2.5rem;
    }
    .banner-inner {
      flex-direction: column-reverse;
      gap: 1.5rem;
      text-align: center;
    }
    .banner-img-wrapper {
      width: 200px;
      height: 200px;
    }
    .container-skills,
    .container-contact {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
  }
</style>
