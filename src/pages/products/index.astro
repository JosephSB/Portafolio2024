---
import HtmlGeneralLayout from "../../layouts/HtmlGeneralLayout.astro";
import DataSideProjects from "../../data/sideprojects.json";
import CardListItem from "../../components/CardListItem.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
---

<HtmlGeneralLayout
  description="Productos digitales creados por Joseph Silva Bendezu: plataformas SaaS, apps con IA, herramientas y librerías open source."
  title="Productos Digitales | Joseph Silva Bendezu - Software Engineer"
>
  <div class="products-page">
    <Breadcrumb items={[{ label: "JosephSB", href: "/" }, { label: "Productos" }]} />
    <header class="page-header">
      <h1 class="page-title">Productos Digitales</h1>
      <p class="page-lede">
        Productos que he construido y mantengo: plataformas SaaS, apps con IA,
        herramientas y librerías open source. Cada uno resolviendo un problema
        real de usuarios reales.
      </p>
    </header>

    <div class="items-grid">
      {
        DataSideProjects.map((item) => (
          <CardListItem
            href={`/products/${item.id}`}
            image={item.portadas[0]}
            title={item.name}
            description={item.description}
            tags={item.tags}
            technologies={item.technologies}
            meta={item.Demo ? "Producto activo" : "En desarrollo"}
          />
        ))
      }
    </div>
  </div>
</HtmlGeneralLayout>

<style>
  .products-page { width: 100%; padding-bottom: 3rem; }
  .page-header {
    margin: 1.5rem 0 2.5rem;
    max-width: 720px;
  }
  .page-title {
    font-family: var(--secondary-font);
    color: var(--text-color);
    margin: 0 0 0.75rem;
    font-size: 1.6rem;
    line-height: 1.25;
  }
  .page-lede {
    color: var(--text-color-2);
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
  }
  .items-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
</style>
