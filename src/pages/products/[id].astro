---
import HtmlGeneralLayout from "../../layouts/HtmlGeneralLayout.astro";
import DataSideProjects from "../../data/sideprojects.json";
import { STORGE_BLOBS } from "../../config";
import { Icon } from "astro-icon/components";
import Breadcrumb from "../../components/Breadcrumb.astro";

export async function getStaticPaths() {
  return DataSideProjects.map((item) => ({
    params: { id: item.id },
    props: { ...item },
  }));
}

const {
  name,
  description,
  tags,
  technologies,
  Demo,
  Repositorio,
  portadas,
} = Astro.props as any;
---

<HtmlGeneralLayout
  description={description}
  title={`${name} | Producto Digital · Joseph Silva Bendezu`}
>
  <div class="product-detail">
    <Breadcrumb
      items={[
        { label: "JosephSB", href: "/" },
        { label: "Productos", href: "/products" },
        { label: name },
      ]}
    />

    <header class="product-hero">
      <div class="hero-text">
        <p class="hero-eyebrow">Producto Digital</p>
        <h1 class="product-title">{name}</h1>
        <p class="product-description">{description}</p>
        <div class="cta-row">
          {Demo && (
            <a class="cta primary" href={Demo} target="_blank" rel="noopener">
              <Icon name="mdi:open-in-new" /> Visitar producto
            </a>
          )}
          {Repositorio && (
            <a class="cta" href={Repositorio} target="_blank" rel="noopener">
              <Icon name="simple-icons:github" /> Repositorio
            </a>
          )}
        </div>
      </div>
      <div class="hero-image-wrap">
        <img
          class="hero-image"
          src={`${STORGE_BLOBS}${portadas[0]}`}
          alt={name}
        />
      </div>
    </header>

    <section class="meta-grid">
      <div class="meta-block">
        <p class="meta-label">Categorías</p>
        <ul class="chip-list chip-primary">
          {tags.map((x: string) => <li>{x}</li>)}
        </ul>
      </div>
      <div class="meta-block">
        <p class="meta-label">Stack técnico</p>
        <ul class="chip-list">
          {technologies.map((x: any) => <li>{x.name}</li>)}
        </ul>
      </div>
    </section>

    {portadas.length > 1 && (
      <section class="gallery-section">
        <h2 class="section-title">Galería</h2>
        <div class="gallery-grid">
          {portadas.slice(1).map((p: string) => (
            <img src={`${STORGE_BLOBS}${p}`} alt={name} loading="lazy" />
          ))}
        </div>
      </section>
    )}
  </div>
</HtmlGeneralLayout>

<style>
  .product-detail { width: 100%; padding-bottom: 4rem; }
  .product-hero {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 3rem;
    align-items: center;
    margin: 3rem 0;
  }
  .hero-eyebrow {
    color: var(--primary-color);
    font-family: var(--secondary-font);
    font-size: 11px;
    letter-spacing: 0.1em;
    margin: 0 0 1rem;
  }
  .product-title {
    color: var(--text-color);
    font-family: var(--secondary-font);
    margin: 0 0 1.25rem;
    font-size: 1.75rem;
    line-height: 1.25;
  }
  .product-description {
    color: var(--text-color-2);
    line-height: 1.75;
    font-size: 15px;
    margin: 0;
  }
  .hero-image-wrap {
    border-radius: 16px;
    overflow: hidden;
    background-color: var(--bd-color-2);
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }
  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cta-row {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.15rem;
    border-radius: 10px;
    color: var(--text-color);
    background-color: var(--bd-color-2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 13px;
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }
  .cta:hover { color: var(--primary-color); border-color: var(--primary-color); }
  .cta.primary {
    background-color: var(--primary-color);
    color: var(--bd-color);
    border-color: var(--primary-color);
    font-weight: 600;
  }
  .cta.primary:hover {
    background-color: transparent;
    color: var(--primary-color);
  }
  .meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding: 2rem;
    background-color: rgba(22, 22, 26, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 14px;
    margin: 2rem 0 3rem;
  }
  .meta-label {
    color: var(--text-color-2);
    margin: 0 0 0.75rem;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .chip-list {
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }
  .chip-list li {
    padding: 0.4rem 0.8rem;
    background-color: var(--bd-color-2);
    border-radius: 999px;
    color: var(--text-color);
    font-size: 12px;
  }
  .chip-primary li {
    background-color: rgba(20, 248, 152, 0.08);
    color: var(--primary-color);
    border: 1px solid rgba(20, 248, 152, 0.25);
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 0.08em;
  }
  .gallery-section { margin-top: 3rem; }
  .section-title {
    font-family: var(--secondary-font);
    color: var(--text-color);
    font-size: 1.05rem;
    margin: 0 0 1.5rem;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }
  .gallery-grid img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
    background-color: var(--bd-color-2);
  }
  @media screen and (max-width: 800px) {
    .product-hero { grid-template-columns: 1fr; gap: 2rem; margin: 2rem 0; }
    .meta-grid { grid-template-columns: 1fr; padding: 1.5rem; gap: 1.5rem; }
  }
</style>
